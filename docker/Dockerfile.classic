# Gemini Live Dockerfile (Classic Builder Compatible)
# Optimized for Google Gemini 2.0 Live API (no STT/TTS/VAD needed)

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    JOINLY_SERVER_HOST="0.0.0.0" \
    JOINLY_SERVER_PORT=8000 \
    JOINLY_LOGGING_PLAIN=1 \
    UV_LINK_MODE="copy" \
    UV_COMPILE_BYTECODE=1

EXPOSE 8000

# Install system dependencies for browser automation and audio
# Gemini Live architecture only needs browser + PulseAudio (no Whisper/Kokoro/Silero)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Browser dependencies
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxcomposite1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    # Audio routing (PulseAudio for virtual audio devices)
    pulseaudio \
    pulseaudio-utils \
    # Virtual display (Xvfb for Linux headless browser)
    xvfb \
    x11vnc \
    # Download tools
    curl \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/* /tmp/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Create non-root user
RUN groupadd --gid 1001 app && \
    useradd --uid 1001 --gid 1001 -m app

WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock ./
COPY client/pyproject.toml client/
COPY common/pyproject.toml common/

# Install dependencies
RUN /root/.local/bin/uv sync --locked --no-install-project --no-install-workspace --no-dev --no-editable

# Copy app source code
COPY . .

# Install application (non-editable mode)
RUN /root/.local/bin/uv sync --locked --no-dev --no-editable

# Set ownership
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Download Playwright browser only (Gemini Live handles STT/TTS internally)
# This significantly reduces image size compared to old architecture (~1.2GB vs ~2.3GB)
RUN PATH="/app/.venv/bin:${PATH}" \
    /app/.venv/bin/python scripts/download_assets.py \
    --assets playwright

# Set working directory and PATH
ENV PATH="/app/.venv/bin:${PATH}"

# Default entrypoint is Python
ENTRYPOINT ["/app/.venv/bin/python"]
